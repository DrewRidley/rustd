{
  "row": "build script: `cargo:rerun-if-env-changed`",
  "package": "app",
  "crates": [
    "app"
  ],
  "steps": [
    {
      "what": "the variable is set",
      "expect": "refused",
      "env": {
        "BM_LEVEL": "loud"
      }
    },
    {
      "what": "the variable changes",
      "expect": "refused",
      "env": {
        "BM_LEVEL": "quiet"
      }
    }
  ]
}
